<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="using:Arbiter.App.Controls"
             xmlns:converters="using:Arbiter.App.Converters"
             xmlns:v="using:Arbiter.App.Views"
             xmlns:vm="using:Arbiter.App.ViewModels.Tracing"
             xmlns:behaviors="using:Arbiter.App.Behaviors"
             mc:Ignorable="d" d:DesignWidth="660" d:DesignHeight="450"
             x:Class="Arbiter.App.Views.TraceView"
             x:DataType="vm:TraceViewModel">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Talgonite.Trace.Background" Color="#373d49" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ToggleButton.trace-state.active">
            <Setter Property="Foreground" Value="{StaticResource Talgonite.Color.LightBlue}" />
        </Style>
        <Style Selector="ToggleButton.trace-state.active /template/ Border#SelectionBorder">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.trace-state:not(.active):checked">
            <Setter Property="Foreground" Value="{StaticResource Talgonite.ToggleButton.Foreground}" />
        </Style>
        <Style Selector="ToggleButton.trace-state:not(.active):checked /template/ Border#SelectionBorder">
            <Setter Property="BorderBrush" Value="{StaticResource Talgonite.ToggleButton.SegmentBorderBrush}" />
        </Style>
        <Style Selector="TextBox.query-error /template/ Border#Border">
            <Setter Property="BorderBrush" Value="{StaticResource Talgonite.TextBox.ErrorBorderBrush}"/>
        </Style>
        <Style Selector="Border.query-help:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Talgonite.Color.LightGray}"/>
        </Style>
        <Style Selector="ToggleButton.query-case">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource Talgonite.Font.Monospace}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Styles>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+F" Command="{Binding ToggleSearchBarCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveAllCommand}" />
    </UserControl.KeyBindings>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Background="{StaticResource Talgonite.Trace.Background}">
        <!-- Toolbar Area -->
        <Border Grid.Row="0" Padding="4">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left Side Buttons -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" ItemSpacing="4">
                    <!-- Start Trace Button -->
                    <Button Command="{Binding StartTracingCommand}"
                            HotKey="F5"
                            ToolTip.Tip="Starts a new packet trace."
                            Classes="toolbar play"
                            IsVisible="{Binding !IsRunning}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Width="16" Height="16"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  Data="{StaticResource Talgonite.Icon.StartPlay}" />
                        </StackPanel>
                    </Button>
                    <!-- Stop Trace Button -->
                    <Button Command="{Binding StopTracingCommand}"
                            HotKey="F6"
                            ToolTip.Tip="Stops the current packet trace."
                            Classes="toolbar stop"
                            IsVisible="{Binding IsRunning, FallbackValue={x:False}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Width="16" Height="16"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  Data="{StaticResource Talgonite.Icon.StopPlay}" />
                        </StackPanel>
                    </Button>
                    <!-- Trace Client Dropdown -->
                    <ComboBox ItemsSource="{Binding TraceClients}"
                              SelectedItem="{Binding SelectedTraceClient}"
                              IsEnabled="{Binding !IsRunning}"
                              FontFamily="{StaticResource Talgonite.Font.Monospace}"
                              PlaceholderText="{Binding TraceClientName, FallbackValue=&lt;none&gt;}"
                              Width="160">
                        <ComboBox.SelectionBoxItemTemplate>
                            <DataTemplate DataType="vm:TraceClientViewModel">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                           VerticalAlignment="Center"
                                           Padding="4"/>
                            </DataTemplate>
                        </ComboBox.SelectionBoxItemTemplate>
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:TraceClientViewModel">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                           VerticalAlignment="Center"
                                           Padding="8,4"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </WrapPanel>

                <!-- Center Buttons -->
                <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemSpacing="4" ItemsAlignment="Center">
                    <!-- Display Mode -->
                    <StackPanel Orientation="Horizontal">
                        <!-- Data Display -->
                        <RadioButton IsChecked="{Binding ShowRawPackets, Converter={x:Static BoolConverters.Not}}"
                                     GroupName="DisplayMode"
                                     ToolTip.Tip="Shows the data payload of each packet."
                                     Classes="segment segment-left">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Canvas Width="16" Height="16" ClipToBounds="True">
                                    <Path Width="16" Height="16"
                                          Stroke="{Binding $parent[RadioButton].Foreground}"
                                          Data="{StaticResource Talgonite.Icon.RevealEye}" />
                                </Canvas>
                                <TextBlock Text="Data" />
                            </StackPanel>
                        </RadioButton>
                        <!-- Encrypted (Raw) Display -->
                        <RadioButton IsChecked="{Binding ShowRawPackets}"
                                     GroupName="DisplayMode"
                                     ToolTip.Tip="Shows the full raw packet, including headers."
                                     Classes="segment segment-right">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Path Width="16" Height="16"
                                      Stroke="{Binding $parent[RadioButton].Foreground}"
                                      Data="{StaticResource Talgonite.Icon.SecureLock}" />
                                <TextBlock Text="Raw" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </WrapPanel>

                <!-- Right Side Buttons -->
                <WrapPanel Grid.Column="2" Orientation="Horizontal" ItemSpacing="4" ItemsAlignment="End">
                    <!-- Toggle Find Button -->
                    <ToggleButton IsChecked="{Binding ShowSearchBar}"
                                  ToolTip.Tip="Shows or hides the search bar."
                                  Classes="trace-state outline"
                                  Classes.active="{Binding IsSearchActive}">
                        <Path Width="16" Height="16"
                              Stroke="{Binding $parent[Button].Foreground}"
                              Data="{StaticResource Talgonite.Icon.SearchMagnify}" />
                    </ToggleButton>

                    <!-- Toggle Filter Button -->
                    <ToggleButton IsChecked="{Binding ShowFilterBar}"
                                  HotKey="Ctrl+G"
                                  ToolTip.Tip="Shows or hides the trace filters."
                                  Classes="trace-state outline"
                                  Classes.active="{Binding IsFilterActive}">
                        <Path Width="16" Height="16"
                              Stroke="{Binding $parent[Button].Foreground}"
                              Data="{StaticResource Talgonite.Icon.FilterFunnel}" />
                    </ToggleButton>
                    
                    <!-- Load Trace Button -->
                    <Button Command="{Binding LoadTraceCommand}"
                            HotKey="Ctrl+O"
                            Classes="toolbar">
                        <ToolTip.Tip>
                            <TextBlock>
                                <Run>Loads a trace from a file.</Run>
                                <LineBreak />
                                <Run>Hold</Run>
                                <Run Classes="hotkey"> [Shift] </Run>
                                <Run>to append to the current trace.</Run>
                            </TextBlock>
                        </ToolTip.Tip>
                        <Path Width="16" Height="16"
                              Stroke="{Binding $parent[Button].Foreground}"
                              Data="{StaticResource Talgonite.Icon.LoadFolder}" />
                    </Button>
                    
                    <!-- Save Trace Button -->
                    <Button Command="{Binding SaveAllCommand}"
                            ToolTip.Tip="Saves this trace to a file."
                            Classes="toolbar"
                            IsEnabled="{Binding IsEmpty, Converter={x:Static BoolConverters.Not}}">
                        <Path Width="16" Height="16"
                              Stroke="{Binding $parent[Button].Foreground}"
                              Data="{StaticResource Talgonite.Icon.SaveDisk}" />
                    </Button>
                    
                    <!-- Clear Trace Button -->
                    <Button Command="{Binding ClearTraceCommand}"
                            ToolTip.Tip="Clears all packets from the trace."
                            Classes="toolbar destructive"
                            IsEnabled="{Binding IsEmpty, Converter={x:Static BoolConverters.Not}}">
                        <Path Width="16" Height="16"
                              Stroke="{Binding $parent[Button].Foreground}"
                              Data="{StaticResource Talgonite.Icon.ClearText}" />
                    </Button>
                    
                    <!-- Scroll to End Button -->
                    <Button Command="{Binding ScrollToEndCommand}"
                            ToolTip.Tip="Scrolls to the end of the trace."
                            Classes="toolbar">
                        <Path Width="16"
                              Height="16"
                              Stroke="{Binding $parent[Button].Foreground}"
                              Data="{StaticResource Talgonite.Icon.ArrowDownEnd}" />
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Filter Bar -->
        <Border Grid.Row="1" IsVisible="{Binding ShowFilterBar}"
                BorderBrush="{StaticResource Talgonite.Window.TitleBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,4"
                MinHeight="50">
            <WrapPanel ItemSpacing="4" VerticalAlignment="Center">
                <!-- Bar Icon -->
                <Border Padding="12,4"
                        BorderBrush="{StaticResource Talgonite.Border.DividerBrush}"
                        BorderThickness="0,0,1,0">
                    <Path Width="16" Height="16"
                          Stroke="{StaticResource Talgonite.TextBlock.DimForeground}"
                          Data="{StaticResource Talgonite.Icon.FilterFunnel}"/>
                </Border>
                
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <!-- Command Filter -->
                    <Label Content="Command"
                           VerticalAlignment="Center">
                        <ToolTip.Tip>
                            <TextBlock>
                                <Span>
                                    <Run>Allows filtering by client or server commands.</Run>
                                    <LineBreak/>
                                    <Run>You can select a single command with</Run>
                                    <Run Classes="hotkey" BaselineAlignment="Center">[Ctrl+Click]</Run>
                                    <Run>.</Run>
                                </Span>
                            </TextBlock>
                        </ToolTip.Tip>
                    </Label>
                    <c:MultiSelectDropdown ItemsSource="{Binding FilterParameters.Commands}"
                                           FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                           FontSize="16"
                                           MaxDropdownHeight="400"
                                           Width="300">
                        <c:MultiSelectDropdown.ItemTemplate>
                            <DataTemplate DataType="vm:CommandFilterViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                               Foreground="{Binding Direction, Converter={x:Static converters:PacketDirectionColorConverter.Converter}}"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="2">
                                        <TextBlock Text="{Binding Value, StringFormat={}0x{0:X2}}"
                                                   Foreground="{StaticResource Talgonite.TextBlock.DimForeground}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </c:MultiSelectDropdown.ItemTemplate>
                    </c:MultiSelectDropdown>
                    
                    <!-- Select All Button -->
                    <Button Command="{Binding SelectAllCommandsCommand}"
                            Classes="toolbar"
                            ToolTip.Tip="Enables all packet commands to be displayed."
                            FontSize="14"
                            FontWeight="Bold"
                            Content="ALL"
                            Padding="8,2"/>

                    <Button Command="{Binding ApplyDefaultCommandFiltersCommand}"
                            Classes="toolbar"
                            ToolTip.Tip="Restores the default packet commands configured in Settings."
                            FontSize="14"
                            FontWeight="Bold"
                            Content="DEFAULT"
                            Padding="8,2"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="4"
                            IsVisible="{Binding HasMultipleFilterClients}">
                    <!-- Character Filter -->
                    <Label Content="Clients"
                           VerticalAlignment="Center">
                        <ToolTip.Tip>
                            <TextBlock>
                                <Span>
                                    <Run>Allows filtering by client name.</Run>
                                    <LineBreak/>
                                    <Run>You can select a single client name with</Run>
                                    <Run Classes="hotkey" BaselineAlignment="Center">[Ctrl+Click]</Run>
                                    <Run>.</Run>
                                </Span>
                            </TextBlock>
                        </ToolTip.Tip>
                    </Label>
                    <c:MultiSelectDropdown ItemsSource="{Binding FilterParameters.Clients}"
                                           FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                           FontSize="16"
                                           MaxDropdownHeight="400"
                                           Width="160">
                        <c:MultiSelectDropdown.ItemTemplate>
                            <DataTemplate DataType="vm:ClientFilterViewModel">
                                <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Stretch">
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName, Converter={x:Static converters:PlaceholderConverter.Converter}, ConverterParameter=&lt;unknown&gt;}"
                                               Foreground="{Binding DisplayName, Converter={x:Static converters:NullOrEmptyBrushConverter.Converter}, ConverterParameter={StaticResource Talgonite.TextBlock.DimForeground}}"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </c:MultiSelectDropdown.ItemTemplate>
                    </c:MultiSelectDropdown>
                    
                    <!-- Select All Button -->
                    <Button Command="{Binding SelectAllClientsCommand}"
                            Classes="toolbar"
                            ToolTip.Tip="Enables all client trace data to be displayed."
                            FontSize="14"
                            FontWeight="Bold"
                            Content="ALL"
                            Padding="8,2"/>
                </StackPanel>
            </WrapPanel>
        </Border>
        
         <!-- Search Bar -->
        <Border Grid.Row="2" IsVisible="{Binding ShowSearchBar}"
                BorderBrush="{StaticResource Talgonite.Window.TitleBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,4"
                MinHeight="50">
            <Grid ColumnDefinitions="48,Auto,460,40,24,Auto,*"
                  RowDefinitions="40,Auto"
                  ColumnSpacing="4">
                <!-- Bar Icon -->
                <Border Grid.Row="0" Grid.Column="0"
                        BorderBrush="{StaticResource Talgonite.Border.DividerBrush}"
                        BorderThickness="0,0,1,0">
                    <Path Width="16" Height="16"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Stroke="{StaticResource Talgonite.TextBlock.DimForeground}"
                          Data="{StaticResource Talgonite.Icon.SearchMagnify}"/>
                </Border>

                    <Label Grid.Row="0" Grid.Column="1" Content="Query" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="2"
                             Name="SearchQueryTextBox"
                             Text="{Binding SearchParameters.QueryText, Mode=TwoWay}"
                             c:QuerySyntax.IsEnabled="True"
                             Classes.query-error="{Binding SearchParameters.HasQueryError}"
                             Watermark="Enter search query..."
                             FontFamily="{StaticResource Talgonite.Font.Monospace}"
                             FontSize="15"
                             Height="40">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding GotoNextSearchResultCommand}"/>
                            <KeyBinding Gesture="Shift+Enter" Command="{Binding GotoPreviousSearchResultCommand}"/>
                        </TextBox.KeyBindings>
                        <TextBox.InnerRightContent>
                            <Border Width="28" VerticalAlignment="Center">
                                <Button Command="{Binding SearchParameters.ClearCommand}"
                                        Classes="clear"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding SearchParameters.HasQueryText}"
                                        ToolTip.Tip="Clears the search query.">
                                    <Path Width="8" Height="8"
                                          Stretch="Uniform"
                                          Stroke="{Binding $parent[Button].Foreground}"
                                          Data="{StaticResource Talgonite.Icon.CrossX}"/>
                                </Button>
                            </Border>
                        </TextBox.InnerRightContent>
                    </TextBox>

                    <ToggleButton Grid.Row="0" Grid.Column="3"
                                  IsChecked="{Binding SearchParameters.IsTextCaseSensitive, Mode=TwoWay}"
                                  Classes="outline query-case"
                                  ToolTip.Tip="Toggles case sensitivity for text and regex searches."
                                  ToolTip.ShowDelay="250">
                        <TextBlock Text="aA"
                                   FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.RenderTransform>
                                <TranslateTransform Y="2"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </ToggleButton>

                    <Border Grid.Row="0" Grid.Column="4"
                            Classes="query-help"
                            Width="22" Height="22"
                            CornerRadius="11"
                            BorderThickness="1"
                            Background="Transparent"
                            BorderBrush="{StaticResource Talgonite.TextBlock.DimForeground}"
                            Cursor="Help"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ToolTip.ShowDelay="250"
                            ToolTip.Placement="Bottom">
                        <Path Width="4" Height="12"
                              Fill="{Binding $parent[Border].BorderBrush}"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="{StaticResource Talgonite.Icon.Information}">
                            <Path.RenderTransform>
                                <TranslateTransform X="1"/>
                            </Path.RenderTransform>
                        </Path>
                        <ToolTip.Tip>
                            <ScrollViewer Width="520"
                                          MaxHeight="460"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Packet Query Syntax"
                                                   Foreground="{StaticResource Talgonite.Color.White}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Foreground="{StaticResource Talgonite.Color.DimWhite}"
                                                   TextWrapping="Wrap">
                                            <Run Text="Separate predicates with spaces or commas. Client and server predicates are alternatives by default; other predicates narrow the results. Use "/><Run Text="AND" Foreground="{StaticResource Talgonite.Color.LightBlue}"/><Run Text=", "/><Run Text="OR" Foreground="{StaticResource Talgonite.Color.LightBlue}"/><Run Text=", or "/><Run Text="NOT" Foreground="{StaticResource Talgonite.Color.LightBlue}"/><Run Text=" only to override that logic. AND is evaluated before OR; parentheses set the grouping."/>
                                        </TextBlock>

                                        <Grid ColumnDefinitions="Auto,*"
                                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                              ColumnSpacing="12"
                                              RowSpacing="4">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Logic"
                                                       Foreground="{StaticResource Talgonite.Color.LightGray}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                       Foreground="{StaticResource Talgonite.Color.DimWhite}"
                                                       FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                                       TextWrapping="Wrap">
                                                <Run Foreground="{StaticResource Talgonite.Color.LightGray}">(</Run>
                                                <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">server</Run><Run>=13 </Run>
                                                <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">OR</Run><Run> </Run>
                                                <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">client</Run><Run>=45-47</Run>
                                                <Run Foreground="{StaticResource Talgonite.Color.LightGray}">)</Run><Run> </Run>
                                                <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">AND NOT text</Run><Run>=error</Run>
                                                <LineBreak/>
                                                <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">server</Run><Run>!=12</Run>
                                            </TextBlock>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Commands"
                                                       Foreground="{StaticResource Talgonite.Color.LightGray}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1"
                                                       Foreground="{StaticResource Talgonite.Color.DimWhite}"
                                                       FontFamily="{StaticResource Talgonite.Font.Monospace}">
                                                <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">client</Run><Run>=45-47|Heartbeat</Run>
                                                <LineBreak/>
                                                <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">server</Run><Run>=05,15|HealthBar</Run>
                                            </TextBlock>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Payload"
                                                       Foreground="{StaticResource Talgonite.Color.LightGray}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1"
                                                       Foreground="{StaticResource Talgonite.Color.DimWhite}"
                                                       FontFamily="{StaticResource Talgonite.Font.Monospace}">
                                                <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">data</Run><Run>=65 01 01</Run>
                                                <LineBreak/>
                                                <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">raw</Run><Run>=AA 00 04 13</Run>
                                            </TextBlock>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Text"
                                                       Foreground="{StaticResource Talgonite.Color.LightGray}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1"
                                                       Foreground="{StaticResource Talgonite.Color.DimWhite}"
                                                       FontFamily="{StaticResource Talgonite.Font.Monospace}">
                                                <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">text</Run><Run>=Test</Run>
                                                <LineBreak/>
                                                <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">text</Run><Run>=&quot;hello world&quot;</Run>
                                                <LineBreak/>
                                                <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">text</Run><Run>=/error|warning/</Run>
                                            </TextBlock>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Client name"
                                                       Foreground="{StaticResource Talgonite.Color.LightGray}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1"
                                                       Foreground="{StaticResource Talgonite.Color.DimWhite}"
                                                       FontFamily="{StaticResource Talgonite.Font.Monospace}">
                                                <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">name</Run><Run>=CharacterName</Run>
                                                <LineBreak/>
                                                <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">name</Run><Run>=/^silo.*$/</Run>
                                            </TextBlock>

                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Sequence"
                                                       Foreground="{StaticResource Talgonite.Color.LightGray}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="5" Grid.Column="1"
                                                       Foreground="{StaticResource Talgonite.Color.DimWhite}"
                                                       FontFamily="{StaticResource Talgonite.Font.Monospace}">
                                                <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">sequence</Run><Run>=02|04-08</Run>
                                            </TextBlock>
                                        </Grid>

                                        <Border Classes="divider-h"/>
                                        <TextBlock Foreground="{StaticResource Talgonite.Color.DimWhite}"
                                                   TextWrapping="Wrap">
                                            <Run>Command and sequence lists can mix individual values and ascending ranges separated by commas or |. For example, 05,12-15,19 is valid, while 17-11 is not.</Run>
                                        </TextBlock>
                                        <TextBlock Foreground="{StaticResource Talgonite.Color.LightGray}"
                                                   TextWrapping="Wrap">
                                            <Run>Numeric values are hexadecimal. Unquoted text and names cannot contain spaces. Text and text regex searches follow the aA case toggle and use ASCII; case sensitivity is on by default. Character names are always case-insensitive. Regex values use /pattern/ and do not accept flags.</Run>
                                        </TextBlock>
                                    </StackPanel>
                            </ScrollViewer>
                        </ToolTip.Tip>
                    </Border>

                    <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3"
                                Orientation="Horizontal"
                                Spacing="6"
                                Margin="0,3,0,0"
                                IsVisible="{Binding SearchParameters.HasQueryError}">
                        <Grid Width="18" Height="16" VerticalAlignment="Center">
                            <Path Fill="{StaticResource Talgonite.Color.LightRed}"
                                  Stretch="Uniform"
                                  Data="{StaticResource Talgonite.Icon.WarningLevel}"/>
                            <TextBlock Text="!"
                                       Foreground="{StaticResource Talgonite.TextBox.Background}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,2,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding SearchParameters.QueryErrorText}"
                                   Foreground="{StaticResource Talgonite.Color.LightRed}"
                                   FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   MaxWidth="460"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding SearchParameters.QueryErrorText}"/>
                    </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="5"
                            Orientation="Horizontal" Spacing="4"
                            IsVisible="{Binding ShowSearchResults}"
                            Height="40">
                    <!-- Result count -->
                    <TextBlock Text="{Binding FormattedSearchResultsText, FallbackValue=no matches}"
                               TextAlignment="Center"
                               Foreground="{StaticResource Talgonite.TextBlock.Foreground}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               MinWidth="40"
                               Margin="8,0"/>
                    
                    <!-- Navigation Buttons -->
                    <StackPanel Orientation="Horizontal"
                                IsVisible="{Binding HasSearchResults}">
                        <Button Command="{Binding GotoPreviousSearchResultCommand}"
                                HotKey="Ctrl+OemOpenBrackets"
                                Classes="toolbar"
                                ToolTip.Tip="Navigates to the previous matching packet.">
                            <Path Width="16" Height="16"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  Data="{StaticResource Talgonite.Icon.ArrowUp}"/>
                        </Button>
                        
                        <Button Command="{Binding GotoNextSearchResultCommand}"
                                HotKey="Ctrl+OemCloseBrackets"
                                Classes="toolbar"
                                ToolTip.Tip="Navigates to the next matching packet.">
                            <Path Width="16" Height="16"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  Data="{StaticResource Talgonite.Icon.ArrowDown}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Trace List -->
        <ListBox Name="TraceListBox"
                 Grid.Row="3"
                 ItemsSource="{Binding FilteredPackets}"
                 SelectedItems="{Binding SelectedPackets}"
                 FontFamily="{StaticResource Talgonite.Font.TraceFont}"
                 FontSize="{StaticResource Talgonite.FontSize.Trace}"
                 Margin="2,0,2,2"
                 SelectionMode="Multiple"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 behaviors:ScrollToIndexBehavior.ScrollToIndex="{Binding ScrollToIndexRequested}"
                 behaviors:ScrollToEndBehavior.ScrollToEnd="{Binding ScrollToEndRequested}"
                 behaviors:ScrollToEndBehavior.AutoScrollToEnd="True">
            <ListBox.KeyBindings>
                <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyToClipboardCommand}" />
                <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveSelectedCommand}" />
                <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedCommand}" />
                <KeyBinding Gesture="Back" Command="{Binding DeleteSelectedCommand}" />
                <KeyBinding Gesture="Ctrl+F" Command="{Binding FindSelectedCommand}" />
                <KeyBinding Gesture="Ctrl+D" Command="{Binding ExcludeSelectedCommand}" />
            </ListBox.KeyBindings>
            <ListBox.DataTemplates>
                <DataTemplate DataType="vm:TracePacketViewModel">
                    <v:TracePacketView />
                </DataTemplate>
            </ListBox.DataTemplates>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy Selected"
                              InputGesture="Ctrl+C"
                              Command="{Binding CopyToClipboardCommand}"/>
                    <MenuItem Header="Save Selected"
                              InputGesture="Ctrl+S"
                              Command="{Binding SaveSelectedCommand}"/>
                    <Separator/>
                    <MenuItem Header="Delete Selected"
                              InputGesture="Delete"
                              Command="{Binding DeleteSelectedCommand}"/>
                    <Separator/>
                    <MenuItem Header="Find Selected"
                              InputGesture="Ctrl+F"
                              Command="{Binding FindSelectedCommand}"/>
                    <MenuItem Header="Exclude Selected"
                              InputGesture="Ctrl+D"
                              Command="{Binding ExcludeSelectedCommand}"/>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
    </Grid>
</UserControl>
