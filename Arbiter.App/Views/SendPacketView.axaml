<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="using:Arbiter.App.Converters"
             xmlns:vm="using:Arbiter.App.ViewModels.Send"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="320"
             x:Class="Arbiter.App.Views.SendPacketView"
             x:DataType="vm:SendPacketViewModel">
    
    <UserControl.Resources>
        <SolidColorBrush x:Key="Talgonite.Send.ValidationErrorBackground" Color="#80260e0b"/>
        <SolidColorBrush x:Key="Talgonite.Send.ValidationErrorForeground" Color="#ed6a5e"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.syntax-help:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Talgonite.Color.LightGray}"/>
        </Style>
    </UserControl.Styles>
    
    <Panel Background="{StaticResource Talgonite.Control.Background}"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Stretch">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Top Toolbar -->
            <Grid Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,4">
                <Border Grid.Column="2"
                        Classes="syntax-help"
                        Width="22" Height="22"
                        CornerRadius="11"
                        BorderThickness="1"
                        Background="Transparent"
                        BorderBrush="{StaticResource Talgonite.TextBlock.DimForeground}"
                        Cursor="Help"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ToolTip.ShowDelay="250"
                        ToolTip.Placement="Bottom">
                    <Path Width="8" Height="12"
                          Fill="Transparent"
                          Stroke="{Binding $parent[Border].BorderBrush}"
                          StrokeThickness="1.75"
                          StrokeLineCap="Round"
                          StrokeJoin="Round"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="{StaticResource Talgonite.Icon.Question}"/>
                    <ToolTip.Tip>
                        <ScrollViewer Width="520"
                                      MaxHeight="460"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Packet Send Syntax"
                                           Foreground="{StaticResource Talgonite.Color.White}"
                                           FontSize="16"/>
                                <TextBlock Foreground="{StaticResource Talgonite.Color.DimWhite}"
                                           TextWrapping="Wrap">
                                    <Run>Enter one packet or control command per line. Packets default to the client direction when no prefix is present.</Run>
                                </TextBlock>

                                <Grid ColumnDefinitions="Auto,*"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                      ColumnSpacing="12"
                                      RowSpacing="4">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Packet"
                                               Foreground="{StaticResource Talgonite.Color.LightGray}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="[&lt;|&gt;] COMMAND [DATA...]"
                                               Foreground="{StaticResource Talgonite.Color.DimWhite}"
                                               FontFamily="{StaticResource Talgonite.Font.Monospace}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Direction"
                                               Foreground="{StaticResource Talgonite.Color.LightGray}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Foreground="{StaticResource Talgonite.Color.DimWhite}"
                                               FontFamily="{StaticResource Talgonite.Font.Monospace}">
                                        <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">&gt;</Run><Run> 43 03 00 0A   client (default)</Run>
                                        <LineBreak/>
                                        <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">&lt;</Run><Run> 32 00         server</Run>
                                    </TextBlock>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Hex bytes"
                                               Foreground="{StaticResource Talgonite.Color.LightGray}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="43 03 00 0A 00 08 01"
                                               Foreground="{StaticResource Talgonite.Color.DimWhite}"
                                               FontFamily="{StaticResource Talgonite.Font.Monospace}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Decimal"
                                               Foreground="{StaticResource Talgonite.Color.LightGray}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                               Foreground="{StaticResource Talgonite.Color.DimWhite}"
                                               FontFamily="{StaticResource Talgonite.Font.Monospace}">
                                        <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">#100</Run><Run> → 64   </Run>
                                        <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">#256</Run><Run> → 01 00</Run>
                                    </TextBlock>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="String"
                                               Foreground="{StaticResource Talgonite.Color.LightGray}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1"
                                               Foreground="{StaticResource Talgonite.Color.DimWhite}"
                                               FontFamily="{StaticResource Talgonite.Font.Monospace}">
                                        <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">&quot;hello&quot;</Run><Run> → 05 68 65 6C 6C 6F</Run>
                                    </TextBlock>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Entity"
                                               Foreground="{StaticResource Talgonite.Color.LightGray}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1"
                                               Foreground="{StaticResource Talgonite.Color.DimWhite}"
                                               FontFamily="{StaticResource Talgonite.Font.Monospace}">
                                        <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">@Deoch</Run><Run> → four-byte known entity ID</Run>
                                    </TextBlock>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Control"
                                               Foreground="{StaticResource Talgonite.Color.LightGray}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1"
                                               Foreground="{StaticResource Talgonite.Color.DimWhite}"
                                               FontFamily="{StaticResource Talgonite.Font.Monospace}">
                                        <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">@wait</Run><Run> 2000   </Run>
                                        <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">@disconnect</Run><Run> / </Run>
                                        <Run Foreground="{StaticResource Talgonite.Color.LightBlue}">@dc</Run>
                                    </TextBlock>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Comments"
                                               Foreground="{StaticResource Talgonite.Color.LightGray}"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="# full line   // full line or trailing"
                                               Foreground="{StaticResource Talgonite.Color.DimWhite}"
                                               FontFamily="{StaticResource Talgonite.Font.Monospace}"/>
                                </Grid>

                                <Border Classes="divider-h"/>
                                <TextBlock Foreground="{StaticResource Talgonite.Color.DimWhite}"
                                           TextWrapping="Wrap">
                                    <Run>Decimal values use the smallest one-, two-, or four-byte big-endian representation. Quoted ASCII strings include a one-byte length prefix. Entity names are resolved when sent; an unknown name becomes ID zero.</Run>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource Talgonite.Color.LightGray}"
                                           TextWrapping="Wrap">
                                    <Run>Scalar paste shortcuts: 0x121 → 01 21, 13BBFF → 13 BB FF, and decimal 12 → #12.</Run>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </ToolTip.Tip>
                </Border>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" ItemSpacing="8" LineSpacing="4" VerticalAlignment="Center">
                    <!-- Delay Dropdown -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Label Content="Delay"
                               Width="60"
                               ToolTip.Tip="The initial delay before sending starts."/>
                        <ComboBox ItemsSource="{Binding AvailableDelays}"
                                  SelectedValue="{Binding SelectedDelay}"
                                  PlaceholderText="&lt;none&gt;"
                                  FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                  FontSize="16"
                                  Width="120" Height="40"
                                  IsEnabled="{Binding !IsSending}">
                            <ComboBox.SelectionBoxItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ., Converter={x:Static converters:TimeSpanConverter.Seconds}, ConverterParameter=None}"
                                               Padding="4" />
                                </DataTemplate>
                            </ComboBox.SelectionBoxItemTemplate>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ., Converter={x:Static converters:TimeSpanConverter.Seconds}, ConverterParameter=None}"
                                               FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                               TextAlignment="Left"
                                               VerticalAlignment="Center"
                                               Padding="8,4"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    
                    <!-- Rate Dropdown -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Label Content="Rate"
                               Width="50"
                               ToolTip.Tip="The delay between each packet being sent."/>
                        <ComboBox ItemsSource="{Binding AvailableRates}"
                                  SelectedValue="{Binding SelectedRate}"
                                  PlaceholderText="&lt;none&gt;"
                                  FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                  FontSize="16"
                                  Width="120" Height="40"
                                  IsEnabled="{Binding !IsSending}">
                            <ComboBox.SelectionBoxItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ., Converter={x:Static converters:TimeSpanConverter.Milliseconds}, ConverterParameter=Instant}"
                                               Padding="4" />
                                </DataTemplate>
                            </ComboBox.SelectionBoxItemTemplate>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ., Converter={x:Static converters:TimeSpanConverter.Milliseconds}, ConverterParameter=Instant}"
                                               FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                               TextAlignment="Left"
                                               VerticalAlignment="Center"
                                               Padding="8,4"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Loop Numeric Input -->
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding LoopEnabled}"
                                  IsEnabled="{Binding !IsSending}"
                                  VerticalAlignment="Center"
                                  Margin="0"
                                  Padding="0">
                            <Label Content="Loop"
                                   Width="50"
                                   Margin="0"
                                   Padding="0">
                                <ToolTip.Tip>
                                    <TextBlock>
                                        <Run>Number of times to send the packets.</Run>
                                        <LineBreak/>
                                        <Run>Use</Run>
                                        <Run Classes="hotkey">-1</Run>
                                        <Run>for infinite loop.</Run>
                                    </TextBlock>
                                </ToolTip.Tip>
                            </Label>
                        </CheckBox>
                        <NumericUpDown Minimum="-1"
                                       Maximum="10000"
                                       Value="{Binding LoopCount}"
                                       PlaceholderText="&lt;times&gt;"
                                       TextAlignment="Center"
                                       MaxWidth="80"
                                       FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                       FontSize="16"
                                       Width="160" Height="40">
                            <NumericUpDown.IsEnabled>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="!IsSending"/>
                                    <Binding Path="LoopEnabled"/>
                                </MultiBinding>
                            </NumericUpDown.IsEnabled>
                        </NumericUpDown>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <!-- Send Button -->
                    <Button Command="{Binding StartSendCommand}"
                            ToolTip.Tip="Starts sending all packets in the input area."
                            HotKey="Shift+Enter"
                            Classes="toolbar play"
                            MinWidth="120" Height="40"
                            Padding="16,4">
                        <Button.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!IsSending"/>
                                <Binding Path="!HasSelection" FallbackValue="{x:False}"/>
                            </MultiBinding>
                        </Button.IsVisible>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Path Width="16" Height="16"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  Data="{StaticResource Talgonite.Icon.RefreshArrows}"/>
                            <TextBlock Text="Send"
                                       Foreground="{Binding $parent[Button].Foreground}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Send Selected Button -->
                    <Button Command="{Binding StartSendCommand}"
                            ToolTip.Tip="Starts sending the selected packets in the input area."
                            HotKey="Shift+Enter"
                            Classes="toolbar play"
                            MinWidth="120" Height="40"
                            Padding="16,4">
                        <Button.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!IsSending" FallbackValue="{x:False}"/>
                                <Binding Path="HasSelection" FallbackValue="{x:False}"/>
                            </MultiBinding>
                        </Button.IsVisible>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Path Width="16" Height="16"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  Data="{StaticResource Talgonite.Icon.RefreshArrows}"/>
                            <TextBlock Text="Send Selected"
                                       Foreground="{Binding $parent[Button].Foreground}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Stop Button -->
                    <Button Command="{Binding StopSendCommand}"
                            ToolTip.Tip="Stops sending any pending packets."
                            Classes="toolbar stop"
                            IsVisible="{Binding IsSending, FallbackValue={x:False}}"
                            MinWidth="120" Height="40"
                            Padding="16,4">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Path Width="16" Height="16"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  Data="{StaticResource Talgonite.Icon.CrossX}"/>
                            <TextBlock Text="Stop"
                                       Foreground="{Binding $parent[Button].Foreground}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            
            <!-- Input Area -->
            <Grid Grid.Row="1">
                <TextBox
                        Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectionStart="{Binding SelectionStart, Mode=TwoWay}"
                        SelectionEnd="{Binding SelectionEnd, Mode=TwoWay}"
                        ClearSelectionOnLostFocus="False"
                        FontSize="16"
                        Classes="editor no-focus-outline"
                        AcceptsTab="False"
                        IsEnabled="{Binding !IsSending}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyToClipboardCommand}" CommandParameter="selection" />
                        <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllCommand}" />
                        <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteFromClipboardCommand}" />
                        <KeyBinding Gesture="Ctrl+X" Command="{Binding CutSelectionCommand}" />
                        <KeyBinding Gesture="Ctrl+OemQuestion" Command="{Binding CommentSelectionCommand}" />
                        <KeyBinding Gesture="Ctrl+Shift+OemQuestion" Command="{Binding UncommentSelectionCommand}" />
                    </TextBox.KeyBindings>
                    <TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy Selection" InputGesture="Ctrl+C"
                                      Command="{Binding CopyToClipboardCommand}" CommandParameter="selection"/>
                            <MenuItem Header="Copy All" Command="{Binding CopyToClipboardCommand}" CommandParameter="all"/>
                            <MenuItem Header="Cut Selection" InputGesture="Ctrl+X" Command="{Binding CutSelectionCommand}"/>
                            <Separator/>
                            <MenuItem Header="Paste" InputGesture="Ctrl+V" Command="{Binding PasteFromClipboardCommand}"/>
                            <MenuItem Header="Select All" InputGesture="Ctrl+A" Command="{Binding SelectAllCommand}"/>
                            <Separator/>
                            <MenuItem Header="Comment Selection" InputGesture="Ctrl+OemQuestion"
                                      Command="{Binding CommentSelectionCommand}"/>
                            <MenuItem Header="Uncomment Selection" InputGesture="Ctrl+Shift+OemQuestion"
                                      Command="{Binding UncommentSelectionCommand}"/>
                            <Separator/>
                            <MenuItem Header="Clear All" Command="{Binding ClearAllCommand}"/>
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>

                <!-- Red error outline overlay (non-interactive) -->
                <Border
                        IsHitTestVisible="False"
                        IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"
                        BorderBrush="{StaticResource Talgonite.Send.ValidationErrorForeground}"
                        BorderThickness="2"
                        CornerRadius="4"
                        Margin="1"/>
            </Grid>
            
            <!-- Error Info -->
            <Border Grid.Row="1"
                        IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"
                        VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                        Background="{StaticResource Talgonite.Send.ValidationErrorBackground}"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{StaticResource Talgonite.Send.ValidationErrorForeground}"
                        Opacity="{Binding ValidationErrorOpacity, FallbackValue=0}"
                        Margin="4"
                        Padding="8,4">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="{StaticResource Talgonite.Transition.Duration}" Easing="QuadraticEaseInOut"/>
                    </Transitions>
                </Border.Transitions>
                <TextBlock Text="{Binding ValidationError}"
                           FontFamily="{StaticResource Talgonite.Font.Monospace}"
                           FontSize="14"
                           Foreground="{StaticResource Talgonite.Send.ValidationErrorForeground}"
                           TextAlignment="Left"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Panel>
    
</UserControl>
