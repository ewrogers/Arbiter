<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:Arbiter.App.Controls"
             xmlns:converters="using:Arbiter.App.Converters"
             xmlns:models="using:Arbiter.App.Models.Tracing"
             xmlns:vm="using:Arbiter.App.ViewModels.Tracing"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="160"
             x:Class="Arbiter.App.Views.TracePacketView"
             x:DataType="vm:TracePacketViewModel">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Talgonite.TracePacket.TimestampForeground" Color="#717479"/>
        <SolidColorBrush x:Key="Talgonite.TracePacket.ClientNameForeground" Color="#e0e0e0"/>
        <SolidColorBrush x:Key="Talgonite.TracePacket.SearchHighlightBackground" Color="#40fadf79"/>
    
        <Geometry x:Key="Talgonite.TracePacket.RightArrow">M1,4 H8 M8,1 L11,4 L8,7</Geometry>
        <Geometry x:Key="Talgonite.TracePacket.LeftArrow">M11,4 H4 M4,1 L1,4 L4,7</Geometry>
    </UserControl.Resources>

    <Grid Background="Transparent"
          Opacity="{Binding Opacity}"
          HorizontalAlignment="Stretch"
          Cursor="Hand">
        <Grid.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="QuadraticEaseInOut"/>
            </Transitions>
        </Grid.Transitions>

        <!-- Compact Layout -->
        <Border Background="Transparent"
                BorderBrush="{StaticResource Talgonite.Window.TitleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="4,2"
                IsVisible="{Binding !IsDetailedView}">
            <Grid ColumnDefinitions="72,104,170,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                           Foreground="{StaticResource Talgonite.TracePacket.TimestampForeground}"/>

                <Grid Grid.Column="1">
                    <TextBlock Text="{Binding ClientName}"
                               Foreground="{StaticResource Talgonite.TracePacket.ClientNameForeground}"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding ClientName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="{Binding DisplayClientName}"
                               Foreground="{StaticResource Talgonite.TextBlock.DimForeground}"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding IsConnectionLabel}"/>
                </Grid>

                <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="4" VerticalAlignment="Center">
                    <Grid Width="12" Height="8" VerticalAlignment="Center">
                        <Path Width="12" Height="8"
                              Stroke="{Binding #CompactCommandNameText.Foreground}"
                              Fill="{Binding #CompactCommandNameText.Foreground}"
                              Data="{StaticResource Talgonite.TracePacket.RightArrow}"
                              IsVisible="{Binding IsClient}"/>
                        <Path Width="12" Height="8"
                              Stroke="{Binding #CompactCommandNameText.Foreground}"
                              Fill="{Binding #CompactCommandNameText.Foreground}"
                              Data="{StaticResource Talgonite.TracePacket.LeftArrow}"
                              IsVisible="{Binding IsServer}"/>
                    </Grid>
                    <TextBlock Name="CompactCommandNameText"
                               Grid.Column="1"
                               Text="{Binding CommandName}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Foreground="{Binding ., Converter={x:Static converters:PacketDirectionColorConverter.Converter}}"/>
                </Grid>

                <Grid Grid.Column="3" ColumnDefinitions="Auto,*" ColumnSpacing="4">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Command, StringFormat={}{0:X2}}"
                               FontFamily="{StaticResource Talgonite.Font.Monospace}"
                               VerticalAlignment="Center"
                               Foreground="{Binding #CompactCommandNameText.Foreground}"/>

                    <controls:HighlightedHexTextBlock Grid.Column="1"
                                                      SourceText="{Binding DisplayValue}"
                                                      Highlights="{Binding DisplaySearchHighlights}"
                                                      HighlightBackground="{StaticResource Talgonite.TracePacket.SearchHighlightBackground}"
                                                      HighlightForeground="{StaticResource Talgonite.Color.LightYellow}"
                                                      HighlightBorderBrush="{StaticResource Talgonite.Color.LightYellow}"
                                                      TextWrapping="NoWrap"
                                                      TextTrimming="CharacterEllipsis"
                                                      FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                                      VerticalAlignment="Center"
                                                      Foreground="{Binding FilterAction, Converter={x:Static converters:PacketFilterColorConverter.Converter}}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Detailed Layout -->
        <Border Background="Transparent"
                BorderBrush="{StaticResource Talgonite.Window.TitleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="4,2"
                IsVisible="{Binding IsDetailedView}">
            <Grid ColumnDefinitions="72,104,170,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="8">
                <TextBlock Grid.RowSpan="2" Grid.Column="0"
                           Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                           Foreground="{StaticResource Talgonite.TracePacket.TimestampForeground}"
                           VerticalAlignment="Top"/>

                <Grid Grid.RowSpan="2" Grid.Column="1" VerticalAlignment="Top">
                    <TextBlock Text="{Binding ClientName}"
                               Foreground="{StaticResource Talgonite.TracePacket.ClientNameForeground}"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding ClientName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="{Binding DisplayClientName}"
                               Foreground="{StaticResource Talgonite.TextBlock.DimForeground}"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding IsConnectionLabel}"/>
                </Grid>

                <StackPanel Grid.Column="2"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <Grid Width="12" Height="8" VerticalAlignment="Center">
                        <Path Width="12" Height="8"
                              Stroke="{Binding #DetailedCommandNameText.Foreground}"
                              Fill="{Binding #DetailedCommandNameText.Foreground}"
                              Data="{StaticResource Talgonite.TracePacket.RightArrow}"
                              IsVisible="{Binding IsClient}"/>
                        <Path Width="12" Height="8"
                              Stroke="{Binding #DetailedCommandNameText.Foreground}"
                              Fill="{Binding #DetailedCommandNameText.Foreground}"
                              Data="{StaticResource Talgonite.TracePacket.LeftArrow}"
                              IsVisible="{Binding IsServer}"/>
                    </Grid>
                    <TextBlock Name="DetailedCommandNameText"
                               Text="{Binding CommandName}"
                               Foreground="{Binding ., Converter={x:Static converters:PacketDirectionColorConverter.Converter}}"/>
                    <TextBlock Text="{Binding Command, StringFormat={}{0:X2}}"
                               FontFamily="{StaticResource Talgonite.Font.Monospace}"
                               Foreground="{Binding #DetailedCommandNameText.Foreground}"/>
                </StackPanel>

                <ItemsControl Grid.Row="1"
                              Grid.Column="2"
                              Grid.ColumnSpan="2"
                              Margin="0,2,0,0"
                              ItemsSource="{Binding DisplayPayloadLines}"
                              IsVisible="{Binding HasDisplayPayload}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:TracePayloadLine" x:CompileBindings="False">
                            <Grid ColumnDefinitions="400,*">
                                <controls:HighlightedHexTextBlock Grid.Column="0"
                                                                  SourceText="{Binding Hex}"
                                                                  Highlights="{Binding Highlights}"
                                                                  HighlightBackground="{StaticResource Talgonite.TracePacket.SearchHighlightBackground}"
                                                                  HighlightForeground="{StaticResource Talgonite.Color.LightYellow}"
                                                                  HighlightBorderBrush="{StaticResource Talgonite.Color.LightYellow}"
                                                                  FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                                                  TextWrapping="NoWrap"
                                                                  Foreground="{Binding $parent[ItemsControl].DataContext.FilterAction, Converter={x:Static converters:PacketFilterColorConverter.Converter}}"/>

                                <Border Grid.Column="1"
                                        BorderBrush="{StaticResource Talgonite.Border.DividerBrush}"
                                        BorderThickness="1,0,0,0"
                                        Padding="8,0,0,0">
                                    <controls:HighlightedAsciiTextBlock SourceText="{Binding Ascii}"
                                                                        Highlights="{Binding Highlights}"
                                                                        HighlightBackground="{StaticResource Talgonite.TracePacket.SearchHighlightBackground}"
                                                                        HighlightForeground="{StaticResource Talgonite.Color.LightYellow}"
                                                                        HighlightBorderBrush="{StaticResource Talgonite.Color.LightYellow}"
                                                                        FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                                                        TextWrapping="NoWrap"
                                                                        Foreground="{StaticResource Talgonite.TextBlock.DimForeground}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
