<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Arbiter.App.ViewModels"
             xmlns:converters="using:Arbiter.App.Converters"
             xmlns:sys="using:System"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="580"
             x:Class="Arbiter.App.Views.HexView"
             x:DataType="vm:RawHexViewModel">
    <UserControl.Resources>
        <sys:Double x:Key="Talgonite.HexView.FontSize">16</sys:Double>
        <sys:Double x:Key="Talgonite.HexView.SmallFontSize">14</sys:Double>
        <sys:Double x:Key="Talgonite.HexView.LabelFontSize">14</sys:Double>
        <sys:Double x:Key="Talgonite.HexView.TextBoxHeight">50</sys:Double>
        <SolidColorBrush x:Key="Talgonite.HexView.LabelBackground" Color="#262b33"/>
        <SolidColorBrush x:Key="Talgonite.HexView.LabelBorderBrush" Color="#373d49"/>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,*,Auto,Auto">
        <Border Grid.Row="0" Grid.RowSpan="8"
                Background="{StaticResource Talgonite.Control.Background}"
                IsHitTestVisible="False"
                Focusable="False"/>
        
        <WrapPanel Grid.Row="0" ItemSpacing="8" LineSpacing="4" Margin="4,8">
            <!-- Command Byte -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Label Content="Command"
                       Width="100"
                       ToolTip.Tip="Command code of the packet (as hex)."/>
                <TextBox Text="{Binding FormattedCommand, Mode=OneWay}"
                         TextAlignment="Right"
                         Watermark="--"
                         Classes="read-only copy-feedback"
                         Classes.copied="{Binding CopyFeedbackField, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=command}"
                         FontFamily="{StaticResource Talgonite.Font.Monospace}"
                         MinWidth="60"
                         Focusable="True">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyToClipboardCommand}" CommandParameter="command" />
                    </TextBox.KeyBindings>
                    <TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy Value" InputGesture="Ctrl+C"
                                      Command="{Binding CopyToClipboardCommand}" CommandParameter="command"/>
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>
            </StackPanel>
            
            <!-- Sequence Byte -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Label Content="Sequence"
                       Width="100"
                       ToolTip.Tip="Incremental sequence number of the packet (as hex)."/>
                <TextBox Text="{Binding FormattedSequence, Mode=OneWay}"
                         TextAlignment="Right"
                         Watermark="--"
                         Classes="read-only copy-feedback"
                         Classes.copied="{Binding CopyFeedbackField, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=sequence}"
                         FontFamily="{StaticResource Talgonite.Font.Monospace}"
                         MinWidth="60"
                         Focusable="True">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyToClipboardCommand}" CommandParameter="sequence" />
                    </TextBox.KeyBindings>
                    <TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy Value" InputGesture="Ctrl+C"
                                      Command="{Binding CopyToClipboardCommand}" CommandParameter="sequence"/>
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>
            </StackPanel>
        </WrapPanel>
        
        <Border Grid.Row="1" Classes="divider-h" Margin="0,2,0,4"/>
        
        <!-- Filtered / Original Toggle -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="8,4,8,0"
                    IsVisible="{Binding WasReplaced, FallbackValue={x:False}}">
            <RadioButton Classes="segment segment-left"
                         IsChecked="{Binding UseFiltered}">
                <TextBlock Text="Filtered"
                           FontSize="16"
                           VerticalAlignment="Center"/>
            </RadioButton>
            <RadioButton Classes="segment segment-right"
                         IsChecked="{Binding !UseFiltered}">
                <TextBlock Text="Original"
                           FontSize="16"
                           VerticalAlignment="Center"/>
            </RadioButton>
        </StackPanel>
        
        <!-- Payload View -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*">
            <Label Grid.Column="0"
                   Content="Payload"
                   ToolTip.Tip="Decrypted payload bytes of the packet (as hex)."
                   Margin="2,4"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding SelectedByteCount, StringFormat={}{0} selected}"
                       TextAlignment="Right"
                       IsVisible="{Binding SelectedByteCount, Converter={x:Static converters:NumericComparerConverter.NotZero}}"
                       Foreground="{StaticResource Talgonite.TextBlock.Foreground}"
                       FontSize="14"
                       Margin="8,0"
                       VerticalAlignment="Center"/>
        </Grid>
        
        <TextBox Name="HexTextBox"
                 Grid.Row="4"
                 Text="{Binding RawHex, Mode=OneWay}"
                 SelectionStart="{Binding HexSelectionStart, Mode=OneWay}"
                 SelectionEnd="{Binding HexSelectionEnd, Mode=OneWay}"
                 ClearSelectionOnLostFocus="False"
                 Classes="editor read-only copy-selection-feedback"
                 Classes.copied="{Binding CopyFeedbackField, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=hex}"
                 FontSize="16"
                 Focusable="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TextBox.KeyBindings>
                <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyToClipboardCommand}" CommandParameter="hex-selection" />
                <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding CopyToClipboardCommand}" CommandParameter="hex-all" />
            </TextBox.KeyBindings>
            <TextBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy Selection" InputGesture="Ctrl+C"
                              Command="{Binding CopyToClipboardCommand}" CommandParameter="hex-selection"/>
                    <MenuItem Header="Copy All" InputGesture="Ctrl+Shift+C"
                              Command="{Binding CopyToClipboardCommand}" CommandParameter="hex-all"/>
                </ContextMenu>
            </TextBox.ContextMenu>
        </TextBox>
        
        <!-- ASCII Text View -->
        <Label Grid.Row="5"
               Content="Text"
               ToolTip.Tip="Decoded ASCII text of the selected bytes."
               Margin="2,4"/>
        <TextBox Name="AsciiTextBox"
                 Grid.Row="6"
                 Text="{Binding DecodedText, Mode=OneWay}"
                 SelectionStart="{Binding TextSelectionStart, Mode=TwoWay}"
                 SelectionEnd="{Binding TextSelectionEnd, Mode=TwoWay}"
                 ClearSelectionOnLostFocus="False"
                 Classes="editor read-only copy-selection-feedback"
                 Classes.copied="{Binding CopyFeedbackField, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=ascii}"
                 FontSize="16"
                 Focusable="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TextBox.KeyBindings>
                <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyToClipboardCommand}" CommandParameter="ascii-selection" />
                <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding CopyToClipboardCommand}" CommandParameter="ascii-all" />
            </TextBox.KeyBindings>
            <TextBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy Selection" InputGesture="Ctrl+C"
                              Command="{Binding CopyToClipboardCommand}" CommandParameter="ascii-selection"/>
                    <MenuItem Header="Copy All" InputGesture="Ctrl+Shift+C"
                              Command="{Binding CopyToClipboardCommand}" CommandParameter="ascii-all"/>
                </ContextMenu>
            </TextBox.ContextMenu>
        </TextBox>
        
        <!-- Integer Values View -->
        <UniformGrid Grid.Row="7" Rows="6" Columns="2">
            <Label Content="Values"
                   ToolTip.Tip="Scalar values of the selected bytes, as big endian."
                   Margin="2,4"/>
            <!-- Base 10/16 Display -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <RadioButton IsChecked="{Binding !ShowValuesAsHex, FallbackValue={x:True}}"
                             Classes="segment segment-left"
                             Height="32" Padding="12,4"
                             GroupName="Base">
                    <TextBlock FontFamily="{StaticResource Talgonite.Font.ConsoleFont}" FontSize="14" FontWeight="SemiBold" Text="Dec"/>
                </RadioButton>
                <RadioButton IsChecked="{Binding ShowValuesAsHex, FallbackValue={x:False}}"
                             Classes="segment segment-right"
                             Height="32" Padding="12,4"
                             GroupName="Base">
                    <TextBlock FontFamily="{StaticResource Talgonite.Font.ConsoleFont}" FontSize="14" FontWeight="SemiBold" Text="Hex"/>
                </RadioButton>
            </StackPanel>
            
            <!-- Signed 8-bit -->
            <TextBox Text="{Binding FormattedSignedByte, FallbackValue=--}"
                     Classes="read-only copy-feedback"
                     Classes.copied="{Binding CopyFeedbackField, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=i8}"
                     FontSize="{StaticResource Talgonite.HexView.FontSize}"
                     FontFamily="{StaticResource Talgonite.Font.Monospace}"
                     TextAlignment="Right"
                     Height="{StaticResource Talgonite.HexView.TextBoxHeight}">
                <TextBox.InnerLeftContent>
                    <Border Background="{StaticResource Talgonite.HexView.LabelBackground}"
                            BorderBrush="{StaticResource Talgonite.HexView.LabelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{Binding $parent[TextBox].CornerRadius}"
                            Margin="4,0"
                            Padding="2"
                            Cursor="Help">
                        <Label Content="i8"
                               FontSize="{StaticResource Talgonite.HexView.LabelFontSize}"
                               ToolTip.Tip="Signed 8-bit value of the first selected byte."/>
                    </Border>
                </TextBox.InnerLeftContent>
                <TextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy Value" Command="{Binding CopyToClipboardCommand}" CommandParameter="i8"/>
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>
            
            <!-- Unsigned 8-bit -->
            <TextBox Text="{Binding FormattedUnsignedByte, FallbackValue=--}"
                     Classes="read-only copy-feedback"
                     Classes.copied="{Binding CopyFeedbackField, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=u8}"
                     FontSize="{StaticResource Talgonite.HexView.FontSize}"
                     FontFamily="{StaticResource Talgonite.Font.Monospace}"
                     TextAlignment="Right"
                     Height="{StaticResource Talgonite.HexView.TextBoxHeight}">
                <TextBox.InnerLeftContent>
                    <Border Background="{StaticResource Talgonite.HexView.LabelBackground}"
                            BorderBrush="{StaticResource Talgonite.HexView.LabelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{Binding $parent[TextBox].CornerRadius}"
                            Margin="4,0"
                            Padding="2"
                            Cursor="Help">
                        <Label Content="u8"
                               FontSize="{StaticResource Talgonite.HexView.LabelFontSize}"
                               ToolTip.Tip="Unsigned 8-bit value of the first selected byte."/>
                    </Border>
                </TextBox.InnerLeftContent>
                <TextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy Value" Command="{Binding CopyToClipboardCommand}" CommandParameter="u8"/>
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>
            
            <!-- Signed 16-bit -->
            <TextBox Text="{Binding FormattedSignedShort, FallbackValue=--}"
                     Classes="read-only copy-feedback"
                     Classes.copied="{Binding CopyFeedbackField, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=i16}"
                     FontSize="{StaticResource Talgonite.HexView.FontSize}"
                     FontFamily="{StaticResource Talgonite.Font.Monospace}"
                     TextAlignment="Right"
                     Height="{StaticResource Talgonite.HexView.TextBoxHeight}">
                <TextBox.InnerLeftContent>
                    <Border Background="{StaticResource Talgonite.HexView.LabelBackground}"
                            BorderBrush="{StaticResource Talgonite.HexView.LabelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{Binding $parent[TextBox].CornerRadius}"
                            Margin="4,0"
                            Padding="2"
                            Cursor="Help">
                        <Label Content="i16"
                               FontSize="{StaticResource Talgonite.HexView.LabelFontSize}"
                               ToolTip.Tip="Signed 16-bit value of the selected bytes."/>
                    </Border>
                </TextBox.InnerLeftContent>
                <TextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy Value" Command="{Binding CopyToClipboardCommand}" CommandParameter="i16"/>
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>
            
            <!-- Unsigned 16-bit -->
            <TextBox Text="{Binding FormattedUnsignedShort, FallbackValue=--}"
                     Classes="read-only copy-feedback"
                     Classes.copied="{Binding CopyFeedbackField, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=u16}"
                     FontSize="{StaticResource Talgonite.HexView.FontSize}"
                     FontFamily="{StaticResource Talgonite.Font.Monospace}"
                     TextAlignment="Right"
                     Height="{StaticResource Talgonite.HexView.TextBoxHeight}">
                <TextBox.InnerLeftContent>
                    <Border Background="{StaticResource Talgonite.HexView.LabelBackground}"
                            BorderBrush="{StaticResource Talgonite.HexView.LabelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{Binding $parent[TextBox].CornerRadius}"
                            Margin="4,0"
                            Padding="2"
                            Cursor="Help">
                        <Label Content="u16"
                               FontSize="{StaticResource Talgonite.HexView.LabelFontSize}"
                               ToolTip.Tip="Unsigned 16-bit value of the selected bytes."/>
                    </Border>
                </TextBox.InnerLeftContent>
                <TextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy Value" Command="{Binding CopyToClipboardCommand}" CommandParameter="u16"/>
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>
            
            <!-- Signed 32-bit -->
            <TextBox Text="{Binding FormattedSignedInt, FallbackValue=--}"
                     Classes="read-only copy-feedback"
                     Classes.copied="{Binding CopyFeedbackField, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=i32}"
                     FontSize="{StaticResource Talgonite.HexView.FontSize}"
                     FontFamily="{StaticResource Talgonite.Font.Monospace}"
                     TextAlignment="Right"
                     Height="{StaticResource Talgonite.HexView.TextBoxHeight}">
                <TextBox.InnerLeftContent>
                    <Border Background="{StaticResource Talgonite.HexView.LabelBackground}"
                            BorderBrush="{StaticResource Talgonite.HexView.LabelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{Binding $parent[TextBox].CornerRadius}"
                            Margin="4,0"
                            Padding="2"
                            Cursor="Help">
                        <Label Content="i32"
                               FontSize="{StaticResource Talgonite.HexView.LabelFontSize}"
                               ToolTip.Tip="Signed 32-bit value of the selected bytes."/>
                    </Border>
                </TextBox.InnerLeftContent>
                <TextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy Value" Command="{Binding CopyToClipboardCommand}" CommandParameter="i32"/>
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>
            
            <!-- Unsigned 32-bit -->
            <TextBox Text="{Binding FormattedUnsignedInt, FallbackValue=--}"
                     Classes="read-only copy-feedback"
                     Classes.copied="{Binding CopyFeedbackField, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=u32}"
                     FontSize="{StaticResource Talgonite.HexView.FontSize}"
                     FontFamily="{StaticResource Talgonite.Font.Monospace}"
                     TextAlignment="Right"
                     Height="{StaticResource Talgonite.HexView.TextBoxHeight}">
                <TextBox.InnerLeftContent>
                    <Border Background="{StaticResource Talgonite.HexView.LabelBackground}"
                            BorderBrush="{StaticResource Talgonite.HexView.LabelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{Binding $parent[TextBox].CornerRadius}"
                            Margin="4,0"
                            Padding="2"
                            Cursor="Help">
                        <Label Content="u32"
                               FontSize="{StaticResource Talgonite.HexView.LabelFontSize}"
                               ToolTip.Tip="Unsigned 32-bit value of the selected bytes."/>
                    </Border>
                </TextBox.InnerLeftContent>
                <TextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy Value" Command="{Binding CopyToClipboardCommand}" CommandParameter="u32"/>
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>
            
             <!-- Signed 64-bit -->
            <TextBox Text="{Binding FormattedSignedLong, FallbackValue=--}"
                     Classes="read-only copy-feedback"
                     Classes.copied="{Binding CopyFeedbackField, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=i64}"
                     FontSize="{StaticResource Talgonite.HexView.FontSize}"
                     FontFamily="{StaticResource Talgonite.Font.Monospace}"
                     TextAlignment="Right"
                     Height="{StaticResource Talgonite.HexView.TextBoxHeight}">
                <TextBox.InnerLeftContent>
                    <Border Background="{StaticResource Talgonite.HexView.LabelBackground}"
                            BorderBrush="{StaticResource Talgonite.HexView.LabelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{Binding $parent[TextBox].CornerRadius}"
                            Margin="4,0"
                            Padding="2"
                            Cursor="Help">
                        <Label Content="i64"
                               FontSize="{StaticResource Talgonite.HexView.LabelFontSize}"
                               ToolTip.Tip="Signed 64-bit value of the selected bytes."/>
                    </Border>
                </TextBox.InnerLeftContent>
                <TextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy Value" Command="{Binding CopyToClipboardCommand}" CommandParameter="i64"/>
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>
            
            <!-- Unsigned 64-bit -->
            <TextBox Text="{Binding FormattedUnsignedLong, FallbackValue=--}"
                     Classes="read-only copy-feedback"
                     Classes.copied="{Binding CopyFeedbackField, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=u64}"
                     FontSize="{StaticResource Talgonite.HexView.FontSize}"
                     FontFamily="{StaticResource Talgonite.Font.Monospace}"
                     TextAlignment="Right"
                     Height="{StaticResource Talgonite.HexView.TextBoxHeight}">
                <TextBox.InnerLeftContent>
                    <Border Background="{StaticResource Talgonite.HexView.LabelBackground}"
                            BorderBrush="{StaticResource Talgonite.HexView.LabelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{Binding $parent[TextBox].CornerRadius}"
                            Margin="4,0"
                            Padding="2"
                            Cursor="Help">
                        <Label Content="u64"
                               FontSize="{StaticResource Talgonite.HexView.LabelFontSize}"
                               ToolTip.Tip="Unsigned 64-bit value of the selected bytes."/>
                    </Border>
                </TextBox.InnerLeftContent>
                <TextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy Value" Command="{Binding CopyToClipboardCommand}" CommandParameter="u64"/>
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>
            
            <!-- Ipv4 Address -->
            <TextBox Text="{Binding FormattedIpAddress, FallbackValue=--}"
                     Classes="read-only copy-feedback"
                     Classes.copied="{Binding CopyFeedbackField, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=ipv4}"
                     FontSize="{StaticResource Talgonite.HexView.FontSize}"
                     FontFamily="{StaticResource Talgonite.Font.Monospace}"
                     TextAlignment="Right"
                     Height="{StaticResource Talgonite.HexView.TextBoxHeight}">
                <TextBox.InnerLeftContent>
                    <Border Background="{StaticResource Talgonite.HexView.LabelBackground}"
                            BorderBrush="{StaticResource Talgonite.HexView.LabelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{Binding $parent[TextBox].CornerRadius}"
                            Margin="4,0"
                            Padding="2"
                            Cursor="Help">
                        <Label Content="ipv4"
                               FontSize="{StaticResource Talgonite.HexView.LabelFontSize}"
                               ToolTip.Tip="IPv4 address value of the selected bytes."/>
                    </Border>
                </TextBox.InnerLeftContent>
                <TextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy Value" Command="{Binding CopyToClipboardCommand}" CommandParameter="ipv4"/>
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>
            
            <!-- Bitflags -->
            <TextBox Text="{Binding FormattedBitFlags, FallbackValue=--}"
                     Classes="read-only copy-feedback"
                     Classes.copied="{Binding CopyFeedbackField, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=flags}"
                     FontSize="{StaticResource Talgonite.HexView.SmallFontSize}"
                     FontFamily="{StaticResource Talgonite.Font.Monospace}"
                     TextAlignment="Right"
                     Height="{StaticResource Talgonite.HexView.TextBoxHeight}">
                <TextBox.InnerLeftContent>
                    <Border Background="{StaticResource Talgonite.HexView.LabelBackground}"
                            BorderBrush="{StaticResource Talgonite.HexView.LabelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{Binding $parent[TextBox].CornerRadius}"
                            Margin="4,2"
                            Padding="2"
                            Cursor="Help">
                        <Label Content="flags"
                               FontSize="{StaticResource Talgonite.HexView.LabelFontSize}"
                               ToolTip.Tip="Bit flag representation of the first selected byte."/>
                    </Border>
                </TextBox.InnerLeftContent>
                <TextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy Value" Command="{Binding CopyToClipboardCommand}" CommandParameter="flags"/>
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>
        </UniformGrid>
    </Grid>

</UserControl>
