<controls:TalgoniteWindow xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:controls="using:Arbiter.App.Controls"
                          xmlns:converters="using:Arbiter.App.Converters"
                          xmlns:models="using:Arbiter.App.Models.Tracing"
                          xmlns:vm="using:Arbiter.App.ViewModels"
                          xmlns:tracing="using:Arbiter.App.ViewModels.Tracing"
                          mc:Ignorable="d"
                          x:Class="Arbiter.App.Views.SettingsWindow"
                          x:DataType="vm:SettingsViewModel"
                          Title="Settings"
                          Width="720" Height="640"
                          CanResize="False"
                          WindowStartupLocation="CenterOwner"
                          ShowInTaskbar="False">
    <controls:TalgoniteWindow.Styles>
        <Style Selector="CheckBox.trace-default:checked /template/ Path#CheckGlyph">
            <Setter Property="Stroke" Value="{StaticResource Talgonite.ComboBox.Foreground}"/>
        </Style>
    </controls:TalgoniteWindow.Styles>

    <controls:TalgoniteWindow.TitleBarContent>
        <DockPanel>
            <Button Command="{Binding HandleResetDefaultsCommand}"
                    Classes="control-box"
                    ToolTip.Tip="Reset to default values.">
                <Path Width="24"
                      Height="16"
                      Stroke="{Binding $parent[Button].Foreground}"
                      Data="{StaticResource Talgonite.Icon.RefreshArrows}"/>
            </Button>
        </DockPanel>
    </controls:TalgoniteWindow.TitleBarContent>
    
    <Grid RowDefinitions="*,Auto" Margin="1,0">
        <TabControl Grid.Row="0" TabStripPlacement="Left" Padding="8"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <!-- Game Client Settings Tab -->
            <TabItem Header="Game Client">
                <StackPanel Spacing="4" Margin="4">
                    <Label Content="Game Client Path"
                           ToolTip.Tip="Path to the game executable."/>
                    <TextBox Name="ClientPathTextBox"
                             Text="{Binding ClientExecutablePath}"
                             FontFamily="{StaticResource Talgonite.Font.Monospace}"
                             PlaceholderText="Path to game client..."
                             FontSize="14"
                             Height="50">
                        <TextBox.InnerRightContent>
                            <Button Command="{Binding LocateClientCommand}"
                                    Classes="toolbar outline"
                                    ToolTip.Tip="Opens a file dialog to select the client executable."
                                    Margin="4,2"
                                    Cursor="Hand">
                                <Path Width="16" Height="16"
                                      Stroke="{Binding $parent[Button].Foreground}"
                                      Data="{StaticResource Talgonite.Icon.LoadFolder}"/>
                            </Button>
                        </TextBox.InnerRightContent>
                    </TextBox>
                    
                    <!-- Options -->
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                        <!-- Skip Intro Video  -->
                        <Label Grid.Row="0" Grid.Column="0"
                               Content="Skip Intro Video"
                               ToolTip.Tip="Bypasses the intro video when starting the client."/>
                        <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                      IsChecked="{Binding SkipIntroVideo}"/>
                        <!-- Suppress Login Notice -->
                        <Label Grid.Row="1" Grid.Column="0"
                               Content="Suppress Login Notice"
                               ToolTip.Tip="Prevents the login notification from being displayed."
                               IsEnabled="False"/>
                        <ToggleSwitch Grid.Row="1" Grid.Column="1"
                                      IsChecked="{Binding SuppressLoginNotice}"
                                      IsEnabled="False"/>
                    </Grid>
                </StackPanel>
            </TabItem>
            
            <!-- Network Settings Tab -->
            <TabItem Header="Network">
                <StackPanel Spacing="4" Margin="4">
                    <!-- Remote Server -->
                    <Label Content="Remote Server Host"
                           ToolTip.Tip="Hostname of the remote game server."/>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                        <TextBox Grid.Column="0"
                                   Text="{Binding RemoteServerAddress}"
                                   FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                   PlaceholderText="Enter a hostname..."
                                   Height="40"/>
                        
                        <Label Grid.Column="1"
                               Content="Port"
                               ToolTip.Tip="Port of the remote game server."/>
                        
                        <NumericUpDown Grid.Column="2"
                                       Value="{Binding RemoteServerPort}"
                                       Minimum="1"
                                       Maximum="65535"
                                       PlaceholderText="1-65535"
                                       TextAlignment="Center"
                                       FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                       Width="100"
                                       Height="40"/>
                    </Grid>
                    
                    <Border Classes="divider-h" Margin="4,8"/>
                    
                    <!-- Local Server Port -->
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                        <Label Grid.Column="0" Content="Local Port"
                               ToolTip.Tip="Port to listen on for local client connections."/>
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding LocalPort}"
                                       Minimum="1"
                                       Maximum="65535"
                                       PlaceholderText="1-65535"
                                       TextAlignment="Center"
                                       FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                       Width="100"
                                       Height="40"/>
                    </Grid>
                </StackPanel>
            </TabItem>
            
            <!-- Tracing Settings Tab -->
            <TabItem Header="Tracing">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="4">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" Margin="4">
                        <Label Grid.Row="0" Grid.Column="0"
                               Content="Max Trace History"
                               ToolTip.Tip="The maximum number of trace packets to store in memory.&#x0a;Beyond this limit, the oldest packets will be discarded."/>
                        <NumericUpDown Grid.Row="0" Grid.Column="1"
                                       Value="{Binding TraceMaxHistory}"
                                       PlaceholderText="10-1000000"
                                       TextAlignment="Center"
                                       FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                       FontSize="16"
                                       Width="120" Height="40"
                                       Minimum="10"
                                       Maximum="1000000"/>
                        
                        <!-- Start Tracing on Startup -->
                        <Label Grid.Row="1" Grid.Column="0"
                               Content="Start Trace on Startup"
                               ToolTip.Tip="Begins a trace automatically when the application starts up."/>
                        <ToggleSwitch Grid.Row="1" Grid.Column="1"
                                      IsChecked="{Binding TraceOnStartup}"/>
                        
                        <!-- Autosave traces -->
                        <Label Grid.Row="2" Grid.Column="0"
                               Content="Autosave Traces on Quit"
                               ToolTip.Tip="Automatically saves live trace packets when the application exits."/>
                        <ToggleSwitch Grid.Row="2" Grid.Column="1"
                                      IsChecked="{Binding TraceAutosave}"/>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="4,0">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Default Packet Filters" FontSize="16"/>
                            <TextBlock Text="Commands selected here are applied when Arbiter starts and restored by DEFAULT."
                                       Foreground="{StaticResource Talgonite.TextBlock.DimForeground}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8" Margin="4,0,4,4">
                        <Grid Grid.Column="0"
                              Background="{StaticResource Talgonite.Window.Background}">
                            <Border Classes="sunken-shadow" CornerRadius="4" ZIndex="100"/>
                            <Border Classes="sunken-highlight" CornerRadius="4" ZIndex="100"/>
                            <Grid RowDefinitions="Auto,*" RowSpacing="6" Margin="10">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                    <TextBlock Grid.Column="0"
                                               Text="Client"
                                               Foreground="{Binding Source={x:Static models:PacketDirection.Client}, Converter={x:Static converters:PacketDirectionColorConverter.Converter}}"
                                               FontSize="15"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Command="{Binding SelectAllDefaultClientCommandsCommand}"
                                            Classes="outline"
                                            Content="ALL"
                                            FontSize="12"
                                            Padding="6,0"/>
                                    <Button Grid.Column="2"
                                            Command="{Binding SelectNoDefaultClientCommandsCommand}"
                                            Classes="outline"
                                            Content="NONE"
                                            FontSize="12"
                                            Padding="6,0"/>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding TraceDefaultClientCommands}"
                                                  Margin="0,0,2,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="tracing:CommandFilterViewModel">
                                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
                                                    <CheckBox Grid.Column="0"
                                                              Classes="trace-default"
                                                              IsChecked="{Binding IsSelected}"
                                                              VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DisplayName}"
                                                               Foreground="{Binding Direction, Converter={x:Static converters:PacketDirectionColorConverter.Converter}}"
                                                               FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Value, StringFormat={}0x{0:X2}}"
                                                               Foreground="{StaticResource Talgonite.TextBlock.DimForeground}"
                                                               FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <Grid Grid.Column="1"
                              Background="{StaticResource Talgonite.Window.Background}">
                            <Border Classes="sunken-shadow" CornerRadius="4" ZIndex="100"/>
                            <Border Classes="sunken-highlight" CornerRadius="4" ZIndex="100"/>
                            <Grid RowDefinitions="Auto,*" RowSpacing="6" Margin="10">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                    <TextBlock Grid.Column="0"
                                               Text="Server"
                                               Foreground="{Binding Source={x:Static models:PacketDirection.Server}, Converter={x:Static converters:PacketDirectionColorConverter.Converter}}"
                                               FontSize="15"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Command="{Binding SelectAllDefaultServerCommandsCommand}"
                                            Classes="outline"
                                            Content="ALL"
                                            FontSize="12"
                                            Padding="6,0"/>
                                    <Button Grid.Column="2"
                                            Command="{Binding SelectNoDefaultServerCommandsCommand}"
                                            Classes="outline"
                                            Content="NONE"
                                            FontSize="12"
                                            Padding="6,0"/>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding TraceDefaultServerCommands}"
                                                  Margin="0,0,2,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="tracing:CommandFilterViewModel">
                                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
                                                    <CheckBox Grid.Column="0"
                                                              Classes="trace-default"
                                                              IsChecked="{Binding IsSelected}"
                                                              VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DisplayName}"
                                                               Foreground="{Binding Direction, Converter={x:Static converters:PacketDirectionColorConverter.Converter}}"
                                                               FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Value, StringFormat={}0x{0:X2}}"
                                                               Foreground="{StaticResource Talgonite.TextBlock.DimForeground}"
                                                               FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            
            <!-- Abilities Tab -->
            <TabItem Header="Spell/Skill">
                <StackPanel Spacing="4" Margin="4">
                    <Grid RowDefinitions="Auto" ColumnDefinitions="*,Auto" Margin="4">
                        <!-- True Look -->
                        <Label Grid.Row="0" Grid.Column="0"
                               Content="Enable True Look Skill/Spell"
                               ToolTip.Tip="Injects additional look abilities (in-game)."/>
                        <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                      IsChecked="{Binding DebugEnableTrueLook}"/>
                    </Grid>
                </StackPanel>
            </TabItem>
            
            <!-- Entities Settings Tab -->
            <TabItem Header="Entities">
                <StackPanel Spacing="4" Margin="4">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" Margin="4">
                        <!-- Show Entity ID for NPCs -->
                        <Label Grid.Row="0" Grid.Column="0"
                               Content="Show Entity ID on NPCs"
                               ToolTip.Tip="Shows the entity ID next to NPC names (in-game)."/>
                        <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                      IsChecked="{Binding DebugShowNpcId}"/>
                        
                        <!-- Show Entity ID for Monsters -->
                        <Label Grid.Row="1" Grid.Column="0"
                               Content="Show Entity ID on Monsters"
                               ToolTip.Tip="Shows the entity ID over monsters (in-game)."/>
                        <ToggleSwitch Grid.Row="1" Grid.Column="1"
                                      IsChecked="{Binding DebugShowMonsterId}"/>
                        
                        <!-- Show Entity ID for Monster Click -->
                        <Label Grid.Row="2" Grid.Column="0"
                               Content="Show Entity ID on Monster Click"
                               ToolTip.Tip="Shows the entity ID in the bar message when clicking monsters (in-game)."/>
                        <ToggleSwitch Grid.Row="2" Grid.Column="1"
                                      IsChecked="{Binding DebugShowMonsterClickId}"/>
                        
                    </Grid>
                </StackPanel>
            </TabItem>
            
            <!-- Dialogs Settings Tab -->
            <TabItem Header="Dialogs">
                <StackPanel Spacing="4" Margin="4">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" Margin="4">
                        <!-- Show Entity ID for Dialogs -->
                        <Label Grid.Row="0" Grid.Column="0"
                               Content="Show Entity ID in Dialogs"
                               ToolTip.Tip="Shows the entity ID within dialogs (in-game)."/>
                        <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                      IsChecked="{Binding DebugShowDialogId}"/>
                        
                        <!-- Show Pursuit ID for Dialogs -->
                        <Label Grid.Row="1" Grid.Column="0"
                               Content="Show Pursuit ID in Menus"
                               ToolTip.Tip="Shows the pursuit ID within dialog menus (in-game)."/>
                        <ToggleSwitch Grid.Row="1" Grid.Column="1"
                                      IsChecked="{Binding DebugShowPursuitId}"/>
                        
                        <!-- Show Item Quantity for Dialogs -->
                        <Label Grid.Row="2" Grid.Column="0"
                               Content="Show Item Quantity in Sell / Deposit"
                               ToolTip.Tip="Shows the item quantity along with item name in sell or deposit menus (in-game)."/>
                        <ToggleSwitch Grid.Row="2" Grid.Column="1"
                                      IsChecked="{Binding DebugShowDialogItemQuantity}"/>
                    </Grid>
                </StackPanel>
            </TabItem>
            
            <!-- Players Settings Tab -->
            <TabItem Header="Players">
                <StackPanel Spacing="4" Margin="4">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" Margin="4">
                        <!-- Show Hidden Players -->
                        <Label Grid.Row="0" Grid.Column="0"
                               Content="Show Hidden Players"
                               ToolTip.Tip="Shows hidden players as translucent (in-game)."/>
                        <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                      IsChecked="{Binding DebugShowHiddenPlayers}"/>
                        <!-- Sticky Player Names -->
                        <Label Grid.Row="1" Grid.Column="0"
                               Content="Always Show Player Names"
                               ToolTip.Tip="Always show player names over their head (in-game)."/>
                        <ToggleSwitch Grid.Row="1" Grid.Column="1"
                                      IsChecked="{Binding DebugShowPlayerNames}"/>
                        
                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Classes="divider-h"/>
                        
                        <!-- Show Equipment Durability -->
                        <Label Grid.Row="3" Grid.Column="0"
                               Content="Show Equipment Durability in Profile"
                               ToolTip.Tip="Shows equipment durability in your profile view (in-game)."/>
                        <ToggleSwitch Grid.Row="3" Grid.Column="1"
                                      IsChecked="{Binding DebugShowEquipmentDurability}"/>
                        
                    </Grid>
                </StackPanel>
            </TabItem>
            
            <!-- NPCs Settings Tab -->
            <TabItem Header="NPCs">
                <StackPanel Spacing="4" Margin="4">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" Margin="4">
                        <!-- Mod Menu -->
                        <Label Grid.Row="0" Grid.Column="0"
                               Content="Inject Global Pursuits Menu"
                               ToolTip.Tip="Allows global pursuits with all NPCs through dialog custom menu."/>
                        <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                      IsChecked="{Binding DebugEnableNpcModMenu}"/>
                    </Grid>
                </StackPanel>
            </TabItem>
            
            <!-- Effects Settings Tab -->
            <TabItem Header="Effects">
                <StackPanel Spacing="4" Margin="4">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" Margin="4">
                        <!-- Classic Visual Effects -->
                        <Label Grid.Row="0" Grid.Column="0"
                               Content="Classic Visual Effects"
                               ToolTip.Tip="Replaces visual effects with their classic versions (in-game)."/>
                        <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                      IsChecked="{Binding DebugUseClassicEffects}"/>
                        
                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Classes="divider-h"/>
                        
                        <!-- Disable Blind -->
                        <Label Grid.Row="2" Grid.Column="0"
                               Content="Disable Blind"
                               ToolTip.Tip="Prevents the screen turning black when blind (in-game)."/>
                        <ToggleSwitch Grid.Row="2" Grid.Column="1"
                                      IsChecked="{Binding DebugDisableBlind}"/>
                    </Grid>
                </StackPanel>
            </TabItem>
            
            <!-- Map Settings Tab -->
            <TabItem Header="Maps">
                <StackPanel Spacing="4" Margin="4">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" Margin="4">
                        <!-- Force Tab Map -->
                        <Label Grid.Row="0" Grid.Column="0"
                               Content="Force Enable Tab Map"
                               ToolTip.Tip="Enables the tab map even if disallowed normally (in-game)."/>
                        <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                      IsChecked="{Binding DebugEnableTabMap}"/>
                        <!-- Zoomed Out Tab Map -->
                        <Label Grid.Row="1" Grid.Column="0"
                               Content="Zoomed Out Tab Map"
                               ToolTip.Tip="Enables the zoomed out tab map display (in-game)."/>
                        <ToggleSwitch Grid.Row="1" Grid.Column="1"
                                      IsChecked="{Binding DebugEnableZoomedOutMap}"/>
                        
                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Classes="divider-h"/>
                        
                        <!-- Disable Weather Effects -->
                        <Label Grid.Row="3" Grid.Column="0"
                               Content="Disable Weather Effects"
                               ToolTip.Tip="Disables weather effects on maps (in-game)."/>
                        <ToggleSwitch Grid.Row="3" Grid.Column="1"
                                      IsChecked="{Binding DebugDisableWeatherEffects}"/>
                        <!-- Disable Darkness -->
                        <Label Grid.Row="4" Grid.Column="0"
                               Content="Disable Darkness"
                               ToolTip.Tip="Disables the darkness/lantern light radius effect (in-game)."/>
                        <ToggleSwitch Grid.Row="4" Grid.Column="1"
                                      IsChecked="{Binding DebugDisableDarkness}"/>
                    </Grid>
                </StackPanel>
            </TabItem>
            
            <!-- Messages Settings Tab -->
            <TabItem Header="Messages">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="4" Margin="4">
                    <!-- Filter Rules -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="4">
                        <Label Grid.Column="0" Content="Notification Filters"
                               ToolTip.Tip="Filter patterns for notifications that will be not displayed (in-game).&#x0a;These will only apply to system messages and world shouts."/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding MessageFilterCount}"
                                 TextAlignment="Center"
                                 Classes="read-only"
                                 FontFamily="{StaticResource  Talgonite.Font.Monospace}"
                                 FontSize="16"
                                 Height="40"
                                 MinWidth="240"
                                 Margin="8,0"
                                 Padding="16,0"
                                 VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Command="{Binding EditMessageFiltersCommand}"
                                Content="Edit.."
                                FontSize="16"
                                Height="40"
                                Padding="8,4"
                                Classes="outline">
                        </Button>
                    </Grid>
                    
                    <Grid Grid.Row="1" RowDefinitions="Auto,*" ColumnDefinitions="*,Auto" Margin="8,0">
                        <!-- Ignore Empty Notifications -->
                        <Label Grid.Row="0" Grid.Column="0"
                               Content="Ignore Empty Notifications"
                               ToolTip.Tip="Prevents empty notifications from scrolling the bar (in-game)."/>
                        <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                      IsChecked="{Binding DebugIgnoreEmptyMessages}"/>
                    </Grid>
                </Grid>
            </TabItem>
            
            <!-- About Tab -->
            <TabItem Header="About">
                <StackPanel Spacing="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Margin="32">
                    <TextBlock Text="Arbiter"
                               TextAlignment="Center"
                               FontSize="48"
                               FontWeight="Light"/>
                    <TextBlock Text="Dark Ages Network Analysis Tool"
                               TextAlignment="Center"
                               FontSize="18"/>
                    <TextBlock Text="{Binding VersionString, FallbackValue=v1.x.x}"
                               TextAlignment="Center"
                               Foreground="{StaticResource Talgonite.TextBlock.DimForeground}"
                               FontSize="16"/>
                    <Border Classes="divider-h" Margin="16,8"/>
                    <TextBlock Text="Erik 'SiLo' Rogers - 2026"
                               TextAlignment="Center"
                               FontSize="18"/>
                    <HyperlinkButton Command="{Binding VisitProjectWebsiteCommand}"
                                     FontFamily="{StaticResource Talgonite.Font.Monospace}"
                                     Margin="4"
                                     HorizontalAlignment="Stretch">
                        <TextBlock TextAlignment="Center" Classes="link">
                            View on Github
                        </TextBlock>
                    </HyperlinkButton>
                </StackPanel>
            </TabItem>
        </TabControl>
        
        <!-- Accept/Cancel Button Area -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource Talgonite.Border.DividerBrush}"
                BorderThickness="0,2,0,0"
                Padding="16,8,16,12">
            <UniformGrid Columns="2" ColumnSpacing="8" Margin="0,0,0,0">
                <!-- OK button -->
                <Button Command="{Binding HandleOkCommand}">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="HasChanges"/>
                            <Binding Path="#ClientPathTextBox.(DataValidationErrors.HasErrors)"
                                     Converter="{x:Static BoolConverters.Not}"/>
                        </MultiBinding>
                    </Button.IsEnabled>
                    <TextBlock Text="Apply"/>
                </Button>
                <!-- Cancel Button -->
                <Button Command="{Binding HandleCancelCommand}" IsCancel="True">
                    <TextBlock Text="Cancel"/>
                </Button>
            </UniformGrid>
        </Border>
    </Grid>
</controls:TalgoniteWindow>
