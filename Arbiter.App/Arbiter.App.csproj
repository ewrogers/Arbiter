<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Arbiter</AssemblyName>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <Company>Erik 'SiLo' Rogers</Company>
        <Product>Arbiter</Product>
        <Version>1.9.1</Version>
        <AssemblyVersion>1.9.1</AssemblyVersion>
        <FileVersion>1.9.1</FileVersion>
        <ApplicationIcon>Assets\arbiter.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
        <AvaloniaResource Include="Themes\**"/>
        <None Include="..\README.md"
              Link="README.md"
              CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.0" />
        <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
        <PackageReference Include="Xaml.Behaviors.Interactions" Version="12.0.5" />
        <PackageReference Include="Xaml.Behaviors.Interactions.Custom" Version="12.0.5" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Arbiter.Interop\Arbiter.Interop.csproj" />
      <ProjectReference Include="..\Arbiter.Imaging\Arbiter.Imaging.csproj" />
      <ProjectReference Include="..\Arbiter.Json\Arbiter.Json.csproj" />
      <ProjectReference Include="..\Arbiter.Net\Arbiter.Net.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\ConsoleLogView.axaml.cs">
        <DependentUpon>ConsoleLog.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\InspectorView.axaml.cs">
        <DependentUpon>PacketInspector.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\HexView.axaml.cs">
        <DependentUpon>RawHexDisplay.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\TraceView.axaml.cs">
        <DependentUpon>TraceLog.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
    </ItemGroup>
</Project>
